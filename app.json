{
  "expo": {
    "name": "Hollow-Knight-Guide",
    "slug": "Hollow-Knight-Guide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hollowknightguide",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "CADisableMinimumFrameRateOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Hollow Knight Guide to use the camera for the photo booth."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hollow Knight Guide to access your photos for the journal.",
          "cameraPermission": "Allow Hollow Knight Guide to take photos for your journal."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow Hollow Knight Guide to save photos to your camera roll."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
