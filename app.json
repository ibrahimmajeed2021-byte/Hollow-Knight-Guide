{
  "expo": {
    "name": "Hollow-Knight-Guide",
    "slug": "Hollow-Knight-Guide",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/HollowKnightGuideAppIcon V1.0.0.png",
    "scheme": "hollowknightguide",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/HollowKnightGuideAppIcon V1.0.0.png",
      "infoPlist": {
        "CADisableMinimumFrameRateOnPhone": true,
        "GADApplicationIdentifier": "ca-app-pub-3940256099942544~1458002511"
      },
      "bundleIdentifier": "com.ibrahimmajeed.Hollow-Knight-Guide"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "name": "Hollow Knight Guide",
      "shortName": "HK Guide",
      "backgroundColor": "#000000",
      "themeColor": "#000000",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Hollow Knight Guide to use the camera for the photo booth."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hollow Knight Guide to access your photos for the journal.",
          "cameraPermission": "Allow Hollow Knight Guide to take photos for your journal."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow Hollow Knight Guide to save photos to your camera roll."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon-fixed.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
